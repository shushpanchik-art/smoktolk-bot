#!/usr/bin/env bash
# Pre-commit hook: локальные проверки качества и безопасности.
#
# Проверки:
#   0) branch guard — запрет прямого коммита в защищённые ветки
#   1) gitleaks    — поиск секретов в staged-версиях файлов
#   2) ruff        — линт Python staged-файлов (только check, без --fix)
#
# Запуск устанавливается через ./scripts/setup-hooks.sh
# Обход (на свой страх и риск): git commit --no-verify

set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── (0) Branch guard: запрет прямого коммита в защищённые ветки ─────────
# Источник истины — то же, что в pre-push (refs/heads/main).
# Здесь сравниваем без префикса refs/heads/.
PROTECTED_BRANCHES="main"
CURRENT_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo "__DETACHED__")"

for protected in $PROTECTED_BRANCHES; do
    if [ "$CURRENT_BRANCH" = "$protected" ]; then
        echo -e "${RED}🛑 Прямой коммит в защищённую ветку запрещён: ${CURRENT_BRANCH}${NC}"
        echo ""
        echo -e "${YELLOW}💡 Правильный flow:${NC}"
        echo "   1. git checkout -b feature/название    # или chore/, fix/, docs/"
        echo "   2. git add ... && git commit -m '...'"
        echo "   3. git push origin feature/название"
        echo "   4. Открой Pull Request на GitHub"
        echo "   5. Дождись CI и сделай merge через UI"
        echo ""
        echo -e "${YELLOW}⚠️  Экстренный обход (только если 100% понимаешь риск):${NC}"
        echo "   git commit --no-verify"
        exit 1
    fi
done

REPO_ROOT="$(git rev-parse --show-toplevel)"
RUFF_BIN=""
if [ -x "$REPO_ROOT/venv/bin/ruff" ]; then
    RUFF_BIN="$REPO_ROOT/venv/bin/ruff"
elif command -v ruff &> /dev/null; then
    RUFF_BIN="$(command -v ruff)"
fi

# ── Список staged-файлов ────────────────────────────────────────────────
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✅ pre-commit: нет staged-файлов для проверки${NC}"
    exit 0
fi

EXIT_CODE=0

# ── (1) gitleaks: секреты в staged-версиях ──────────────────────────────
echo -e "${YELLOW}🔍 gitleaks: проверка staged-файлов на секреты...${NC}"

if ! command -v gitleaks &> /dev/null; then
    echo -e "${RED}❌ gitleaks не установлен — установка обязательна${NC}"
    echo "   https://github.com/gitleaks/gitleaks#getting-started"
    exit 1
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

while IFS= read -r file; do
    [ -z "$file" ] && continue
    mkdir -p "$TMPDIR/$(dirname "$file")"
    git show ":$file" > "$TMPDIR/$file" 2>/dev/null || true
done <<< "$STAGED_FILES"

if gitleaks dir "$TMPDIR" --no-banner --redact --verbose 2>&1; then
    echo -e "${GREEN}✅ gitleaks: секретов не найдено${NC}"
else
    echo ""
    echo -e "${RED}🚨 СЕКРЕТЫ ОБНАРУЖЕНЫ! Коммит будет отменён.${NC}"
    echo -e "${YELLOW}💡 Убери секрет из файла, используй os.getenv() и .env${NC}"
    EXIT_CODE=1
fi

# ── (2) ruff: линт только staged-файлов *.py ────────────────────────────
STAGED_PY=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)

if [ -n "$STAGED_PY" ]; then
    echo ""
    echo -e "${YELLOW}🔍 ruff: линт staged Python-файлов...${NC}"

    if [ -z "$RUFF_BIN" ]; then
        echo -e "${RED}❌ ruff не найден (ни в venv/bin/ruff, ни в PATH)${NC}"
        echo "   Установка: pip install ruff==0.15.12"
        EXIT_CODE=1
    else
        # Передаём список файлов; используем тот же exclude, что и в CI
        # shellcheck disable=SC2086
        if echo "$STAGED_PY" | xargs "$RUFF_BIN" check \
                --exclude venv --exclude data --exclude backups --exclude logs \
                --output-format=concise; then
            echo -e "${GREEN}✅ ruff: нарушений не найдено${NC}"
        else
            echo ""
            echo -e "${RED}🚨 ruff нашёл нарушения. Коммит будет отменён.${NC}"
            echo -e "${YELLOW}💡 Автофикс: ${NC}venv/bin/ruff check --fix <файлы>"
            EXIT_CODE=1
        fi
    fi
else
    echo ""
    echo -e "${GREEN}✅ ruff: нет staged *.py файлов, проверка пропущена${NC}"
fi

# ── Итог ─────────────────────────────────────────────────────────────────
if [ "$EXIT_CODE" -ne 0 ]; then
    echo ""
    echo -e "${RED}❌ pre-commit: проверки не пройдены, коммит ОТМЕНЁН${NC}"
    echo -e "${YELLOW}⚠️  Экстренный обход (использовать только осознанно):${NC}"
    echo "   git commit --no-verify"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ pre-commit: все проверки пройдены, коммит разрешён${NC}"
exit 0
