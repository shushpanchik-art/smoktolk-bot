#!/usr/bin/env bash
# Pre-commit hook: проверка staged-файлов на секреты через gitleaks
# Блокирует коммит, если найдены секреты

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}🔍 gitleaks: проверка staged-файлов на секреты...${NC}"

# Проверка наличия gitleaks
if ! command -v gitleaks &> /dev/null; then
    echo -e "${RED}❌ gitleaks не установлен${NC}"
    exit 1
fi

# Получаем список staged-файлов (только добавленные/изменённые, не удалённые)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✅ Нет staged-файлов для проверки${NC}"
    exit 0
fi

# Создаём временную директорию и копируем туда staged-версии файлов
TMPDIR=$(mktemp -d)
trap "rm -rf $TMPDIR" EXIT

while IFS= read -r file; do
    # Создаём поддиректории, если нужно
    mkdir -p "$TMPDIR/$(dirname "$file")"
    # Берём именно staged-версию (что в индексе, не на диске)
    git show ":$file" > "$TMPDIR/$file" 2>/dev/null || true
done <<< "$STAGED_FILES"

# Сканируем временную директорию
if gitleaks dir "$TMPDIR" --no-banner --redact --verbose 2>&1; then
    echo -e "${GREEN}✅ Секретов не найдено, коммит разрешён${NC}"
    exit 0
else
    echo ""
    echo -e "${RED}🚨 СЕКРЕТЫ ОБНАРУЖЕНЫ! Коммит ОТМЕНЁН.${NC}"
    echo -e "${YELLOW}💡 Что делать:${NC}"
    echo "   1. Убери секрет из файла"
    echo "   2. Используй .env / os.getenv() вместо хардкода"
    echo "   3. git add → git commit заново"
    echo ""
    echo -e "${YELLOW}⚠️  Обход (только если 100% ложное срабатывание):${NC}"
    echo "   git commit --no-verify"
    exit 1
fi
