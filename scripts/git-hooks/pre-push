#!/usr/bin/env bash
# Pre-push hook: блокирует прямой push в защищённые ветки.
# Замена GitHub Branch Protection для приватных репо на free-тарифе.
#
# Защищённые ветки настраиваются через env var SMOKTOLK_PROTECTED_BRANCHES
# (space-separated, формат refs/heads/<name>). По умолчанию: refs/heads/main
#
# Обход (на свой страх и риск): git push --no-verify
#
# Edge-cases, которые хук обрабатывает:
#   1. git push origin main                — блокирует
#   2. git push origin feature:main        — блокирует (проверяет remote_ref)
#   3. git push origin --delete main       — блокирует (ZERO_SHA detection)
#   4. git push --force origin main        — блокирует (force не имеет значения)
#   5. git push --all                      — блокирует main, если в matching
#   6. detached HEAD push в main           — блокирует (не зависит от symbolic-ref)
#
# НЕ обрабатывает (by design):
#   - git push --no-verify                 — git bypass-механизм
#   - push тегов с именем 'main'           — это refs/tags/main, не refs/heads/main
#
# Audit log: все блокировки пишутся в .git/branch-guard.log

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Конфиг через env var (для будущей поддержки develop и т.п.)
PROTECTED_BRANCHES="${SMOKTOLK_PROTECTED_BRANCHES:-refs/heads/main}"

# Audit log в .git (не уходит в репо, локальный за-сессионный лог)
GIT_DIR="$(git rev-parse --git-dir)"
AUDIT_LOG="${GIT_DIR}/branch-guard.log"

ZERO_SHA="0000000000000000000000000000000000000000"
BLOCKED=0
BLOCKED_REFS=""

log_audit() {
    local action="$1"
    local ref="$2"
    local user
    user="$(git config user.email 2>/dev/null || echo 'unknown')"
    echo "$(date -Iseconds) [pre-push] action=${action} ref=${ref} user=${user}" >> "$AUDIT_LOG"
}

# Git передаёт через stdin строки:
#   <local_ref> <local_sha> <remote_ref> <remote_sha>
# Проверяем remote_ref — куда реально пойдёт push.
while read -r local_ref local_sha remote_ref remote_sha; do
    # Пустая строка / неполная — пропускаем
    [ -z "${remote_ref:-}" ] && continue

    for protected in $PROTECTED_BRANCHES; do
        if [ "$remote_ref" = "$protected" ]; then
            if [ "${local_sha:-}" = "$ZERO_SHA" ]; then
                echo -e "${RED}🛑 Попытка УДАЛИТЬ защищённую ветку: $remote_ref${NC}" >&2
                log_audit "BLOCKED_DELETE" "$remote_ref"
            else
                echo -e "${RED}🛑 Прямой push в защищённую ветку запрещён: $remote_ref${NC}" >&2
                log_audit "BLOCKED_PUSH" "$remote_ref"
            fi
            BLOCKED=1
            BLOCKED_REFS="${BLOCKED_REFS} ${remote_ref}"
        fi
    done
done

if [ "$BLOCKED" -eq 1 ]; then
    echo "" >&2
    echo -e "${YELLOW}💡 Правильный flow:${NC}" >&2
    echo "   1. git checkout -b feature/название" >&2
    echo "   2. git push origin feature/название" >&2
    echo "   3. Открой Pull Request на GitHub" >&2
    echo "   4. Дождись прохождения CI" >&2
    echo "   5. Merge через UI" >&2
    echo "" >&2
    echo -e "${YELLOW}⚠️  Экстренный обход (только если 100% понимаешь риск):${NC}" >&2
    echo "   git push --no-verify" >&2
    echo "" >&2
    echo -e "${YELLOW}📜 Audit log: ${AUDIT_LOG}${NC}" >&2
    exit 1
fi

echo -e "${GREEN}✅ pre-push: push в незащищённую ветку разрешён${NC}"
exit 0
