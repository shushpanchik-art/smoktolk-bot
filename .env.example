# Скопировать в .env и заполнить:
# cp .env.example .env && nano .env

# === ОБЯЗАТЕЛЬНЫЕ ===
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
ADMIN_ID=PUT_YOUR_TELEGRAM_ID_HERE
ADMIN_USERNAME=your_telegram_username_without_@

# === БД (обязательно полный путь!) ===
DB_PATH=/opt/smoktolk/bot/data/smoktolk.db

# === Webhook от кассы ===
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8080
WEBHOOK_TOKEN=GENERATE_RANDOM_32CHARS_HERE
WEBHOOK_MODE=stub
# POS_API_KEY=  # пока заглушка, не требуется

# === Ассортимент (публичная ссылка Яндекс.Диска на Excel) ===
CATALOG_URL=https://disk.yandex.ru/i/XXXXXXXXXXXXX

# === Часовой пояс для отчётов ===
TZ=Europe/Moscow

# ── Адрес магазина (необязательно — есть дефолты в config.py) ──
STORE_CITY=Москва
STORE_ADDRESS=Волгоградский проспект, 10с2
STORE_HOURS=Ежедневно, 8:00 – 23:00
STORE_MAP_URL=https://yandex.com/maps/-/CPgJENnt
STORE_PHONE=
