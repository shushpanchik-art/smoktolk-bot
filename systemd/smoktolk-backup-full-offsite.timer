[Unit]
Description=Daily SMOKTOLK full-project offsite backup at 23:30 UTC
Documentation=file:/opt/smoktolk/bot/scripts/backup_full_offsite.sh
Documentation=file:/opt/smoktolk/bot/docs/BACKUP.md

[Timer]
OnCalendar=*-*-* 23:30:00 UTC
# 23:30 UTC ежедневно (= 02:30 MSK).
# Через native Yandex API заливка 100 МБ занимает ~50 секунд.
# Поздняя ночь — минимум нагрузки на Я.Диск и канал сервера.
# Persistent=true → если сервер был выключен, отработает при старте.
Persistent=true
RandomizedDelaySec=2min
Unit=smoktolk-backup-full-offsite.service

[Install]
WantedBy=timers.target
