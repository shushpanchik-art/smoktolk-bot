[Unit]
Description=SMOKTOLK full-project offsite backup to Yandex.Disk (native API, tar.gz of /opt/smoktolk)
Documentation=file:/opt/smoktolk/bot/scripts/backup_full_offsite.sh
Documentation=file:/opt/smoktolk/bot/docs/BACKUP.md
After=network-online.target
Wants=network-online.target
# Идёт в 20:00 UTC (= 23:00 MSK), на 3ч 50мин раньше БД-offsite (23:50 UTC).
# Большой запас выбран из-за тротлинга Я.Диска WebDAV: 100 МБ заливаются
# в худшем случае 60-90 минут. См. комментарии в backup_full_offsite.sh.
# Не зависит от smoktolk-backup-offsite.service (тот стартует значительно позже).
# В отличие от backup_offsite.sh, который копирует уже готовый локальный
# дамп БД, full-tar самодостаточен — нужен только живой /opt/smoktolk/.
OnFailure=smoktolk-backup-full-offsite-alert.service

[Service]
Type=oneshot
User=smoktolk
Group=smoktolk
ExecStart=/opt/smoktolk/bot/scripts/backup_full_offsite.sh

StandardOutput=append:/opt/smoktolk/bot/logs/backup-full-offsite.log
StandardError=append:/opt/smoktolk/bot/logs/backup-full-offsite.log

# Общий state-каталог со всеми бэкап-юнитами — там notify_admin.sh
# кладёт offsite-full-failed state-файл рядом с offsite-failed и failed.
StateDirectory=smoktolk-backup
StateDirectoryMode=0775

# Я.Диск WebDAV тротлит upload: 100 МБ может заливаться до 60-90 мин
# из-за резкой деградации скорости после ~40 МБ. Server-side copy
# history→latest добавляет 0.5-1 мин. TimeoutStartSec=180min = запас 2×.
# Если действительно упрёмся в 3 часа — это уже не таймаут, а инцидент.
TimeoutStartSec=180min

# Безопасность.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Читаем /opt/smoktolk (целиком) и rclone.conf; пишем в staging и logs.
ReadWritePaths=/var/backups/smoktolk-full-offsite /opt/smoktolk/bot/logs /var/lib/smoktolk-backup
ReadOnlyPaths=/opt/smoktolk /var/lib/smoktolk-rclone

[Install]
WantedBy=multi-user.target
